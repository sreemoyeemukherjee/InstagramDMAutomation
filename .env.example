# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Instagram (leave DRY_RUN=true until these are real)
DRY_RUN=true
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# graph.instagram.com = Instagram API with Instagram Login (no linked FB Page needed, recommended).
# graph.facebook.com = older Facebook Login path, only if you set up that way instead.
GRAPH_API_HOST=graph.instagram.com
